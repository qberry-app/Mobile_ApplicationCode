ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AWSCore" "${PODS_CONFIGURATION_BUILD_DIR}/AWSS3" "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/AlamofireObjectMapper" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaAsyncSocket" "${PODS_CONFIGURATION_BUILD_DIR}/CountryPickerView" "${PODS_CONFIGURATION_BUILD_DIR}/DatePicker" "${PODS_CONFIGURATION_BUILD_DIR}/DropDown" "${PODS_CONFIGURATION_BUILD_DIR}/Extended" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAppCheckInterop" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuth" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuthInterop" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCore" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCoreExtension" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCoreInternal" "${PODS_CONFIGURATION_BUILD_DIR}/GTMSessionFetcher" "${PODS_CONFIGURATION_BUILD_DIR}/GoogleUtilities" "${PODS_CONFIGURATION_BUILD_DIR}/JKVValue" "${PODS_CONFIGURATION_BUILD_DIR}/JXSegmentedView" "${PODS_CONFIGURATION_BUILD_DIR}/NVActivityIndicatorView" "${PODS_CONFIGURATION_BUILD_DIR}/ObjectMapper" "${PODS_CONFIGURATION_BUILD_DIR}/PMAlertController" "${PODS_CONFIGURATION_BUILD_DIR}/RMQClient" "${PODS_CONFIGURATION_BUILD_DIR}/RecaptchaInterop" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/SOTabBar" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftCharts" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftMessages" "${PODS_CONFIGURATION_BUILD_DIR}/TPKeyboardAvoidingSwift" "${PODS_CONFIGURATION_BUILD_DIR}/Toast-Swift" "${PODS_CONFIGURATION_BUILD_DIR}/WXImageCompress" "${PODS_ROOT}/Plaid" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Plaid"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AWSCore/AWSCore.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/AWSS3/AWSS3.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/AlamofireObjectMapper/AlamofireObjectMapper.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaAsyncSocket/CocoaAsyncSocket.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CountryPickerView/CountryPickerView.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DatePicker/DatePicker.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DropDown/DropDown.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Extended/Extended.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAppCheckInterop/FirebaseAppCheckInterop.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuth/FirebaseAuth.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuthInterop/FirebaseAuthInterop.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCore/FirebaseCore.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCoreExtension/FirebaseCoreExtension.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCoreInternal/FirebaseCoreInternal.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GTMSessionFetcher/GTMSessionFetcher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GoogleUtilities/GoogleUtilities.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/JKVValue/JKVValue.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/JXSegmentedView/JXSegmentedView.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/NVActivityIndicatorView/NVActivityIndicatorView.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ObjectMapper/ObjectMapper.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/PMAlertController/PMAlertController.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RMQClient/RMQClient.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RecaptchaInterop/RecaptchaInterop.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage/SDWebImage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SOTabBar/SOTabBar.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftCharts/SwiftCharts.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftMessages/SwiftMessages.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TPKeyboardAvoidingSwift/TPKeyboardAvoidingSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Toast-Swift/Toast_Swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WXImageCompress/WXImageCompress.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"sqlite3" -l"z" -framework "AWSCore" -framework "AWSS3" -framework "Alamofire" -framework "AlamofireObjectMapper" -framework "CFNetwork" -framework "CocoaAsyncSocket" -framework "CoreGraphics" -framework "CountryPickerView" -framework "DatePicker" -framework "DropDown" -framework "Extended" -framework "FirebaseAppCheckInterop" -framework "FirebaseAuth" -framework "FirebaseAuthInterop" -framework "FirebaseCore" -framework "FirebaseCoreExtension" -framework "FirebaseCoreInternal" -framework "Foundation" -framework "GTMSessionFetcher" -framework "GoogleUtilities" -framework "ImageIO" -framework "JKVValue" -framework "JXSegmentedView" -framework "LinkKit" -framework "NVActivityIndicatorView" -framework "ObjectMapper" -framework "PMAlertController" -framework "QuartzCore" -framework "RMQClient" -framework "RecaptchaInterop" -framework "SDWebImage" -framework "SOTabBar" -framework "SafariServices" -framework "Security" -framework "SwiftCharts" -framework "SwiftMessages" -framework "SystemConfiguration" -framework "TPKeyboardAvoidingSwift" -framework "Toast_Swift" -framework "UIKit" -framework "WXImageCompress" -framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AWSCore" "-F${PODS_CONFIGURATION_BUILD_DIR}/AWSS3" "-F${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "-F${PODS_CONFIGURATION_BUILD_DIR}/AlamofireObjectMapper" "-F${PODS_CONFIGURATION_BUILD_DIR}/CocoaAsyncSocket" "-F${PODS_CONFIGURATION_BUILD_DIR}/CountryPickerView" "-F${PODS_CONFIGURATION_BUILD_DIR}/DatePicker" "-F${PODS_CONFIGURATION_BUILD_DIR}/DropDown" "-F${PODS_CONFIGURATION_BUILD_DIR}/Extended" "-F${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAppCheckInterop" "-F${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuth" "-F${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuthInterop" "-F${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCore" "-F${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCoreExtension" "-F${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCoreInternal" "-F${PODS_CONFIGURATION_BUILD_DIR}/GTMSessionFetcher" "-F${PODS_CONFIGURATION_BUILD_DIR}/GoogleUtilities" "-F${PODS_CONFIGURATION_BUILD_DIR}/JKVValue" "-F${PODS_CONFIGURATION_BUILD_DIR}/JXSegmentedView" "-F${PODS_CONFIGURATION_BUILD_DIR}/NVActivityIndicatorView" "-F${PODS_CONFIGURATION_BUILD_DIR}/ObjectMapper" "-F${PODS_CONFIGURATION_BUILD_DIR}/PMAlertController" "-F${PODS_CONFIGURATION_BUILD_DIR}/Plaid" "-F${PODS_CONFIGURATION_BUILD_DIR}/RMQClient" "-F${PODS_CONFIGURATION_BUILD_DIR}/RecaptchaInterop" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/SOTabBar" "-F${PODS_CONFIGURATION_BUILD_DIR}/SwiftCharts" "-F${PODS_CONFIGURATION_BUILD_DIR}/SwiftMessages" "-F${PODS_CONFIGURATION_BUILD_DIR}/TPKeyboardAvoidingSwift" "-F${PODS_CONFIGURATION_BUILD_DIR}/Toast-Swift" "-F${PODS_CONFIGURATION_BUILD_DIR}/WXImageCompress"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
